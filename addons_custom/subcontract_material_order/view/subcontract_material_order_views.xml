<?xml version="1.0"?>
<odoo>
    <record id="subcontract_material_order_action" model="ir.actions.act_window">
        <field name="name">Gia công nguyên vật liệu</field>
        <field name="res_model">subcontract.material.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="subcontract_material_order_list" model="ir.ui.view">
        <field name="name">subcontract.material.order.list</field>
        <field name="model">subcontract.material.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subcontractor_id"/>
                <field name="date_order"/>
                <field name="expected_date"/>
                <field name="person_in_charge_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="subcontract_material_order_form" model="ir.ui.view">
        <field name="name">subcontract.material.order.form</field>
        <field name="model">subcontract.material.order</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <button name="action_create_order" type="object" string="Lập đơn" invisible="state != 'draft'"/>
                <button name="action_approve" type="object" string="Gửi duyệt" invisible="state != 'confirmed'"/>
                <button name="action_draft" type="object" string="Quay lại nháp" invisible="state != 'confirmed'"/>
                <button name="action_approve_mgr" type="object" string="Phê duyệt" invisible="state != 'to_approve_mgr'"/>
                <button name="action_refuse_mgr" type="object" string="Từ chối" invisible="state != 'to_approve_mgr'"/>
                <button name="action_approve_cfo" type="object" string="Phê duyệt" invisible="state != 'to_approve_cfo'"/>
                <button name="action_refuse_cfo" type="object" string="Từ chối" invisible="state != 'to_approve_cfo'"/>
                <button name="action_approve_ceo" type="object" string="Phê duyệt" invisible="state != 'to_approve_ceo'"/>
                <button name="action_refuse_ceo" type="object" string="Từ chối" invisible="state != 'to_approve_ceo'"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done" options="{'clickable':'1'}"/>
            </header>
            <sheet>
                <h1>
                <field name="name"/>
                </h1>
                <group>
                    <group>
                        <field name="subcontractor_id" options="{'no_create': true}"/>
                        <field name="person_in_charge_id" options="{'no_create': true}"/>
                        <field name="finished_warehouse_id" options="{'no_create': true}"/>
                        <field name="raw_material_warehouse_id" options="{'no_create': true}"/>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="date_order"/>
                        <field name="expected_date"/>
                        <field name="date_finished"/>
                        <field name="currency_id"/>
                        <field name="finished_status"/>
                        <field name="raw_material_status"/>
                    </group>
                </group>
                <notebook>
                    <page string="Chi tiết">
                        <field name="line_ids"/>
                    </page>
                    <page string="Thành phẩm">
                        <field name="finished_line_ids">
                            <list>
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="qty_received"/>
                                <field name="qty_remaining"/>
                            </list>
                        </field>
                    </page>
                    <page string="Nguyên vật liệu">
                        <field name="raw_line_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="product_id" domain="[('id', 'in', product_domain_ids)]"/>
                                <field name="material_id"/>
                                <field name="qty_needed"/>
                                <field name="qty_issued"/>
                                <field name="qty_returned"/>
                            </list>
                        </field>
                    </page>
                    <page string="Lịch sử hàng về">
                        <field name="history_ids" readonly="1">
                            <list>
                                <field name="date_receipted"/>
                                <field name="total_qty_receipted"/>
                                <button class="btn-primary" name="action_view_detail" type="object" string="Chi tiết"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                </group>
            </sheet>
            </form>
        </field>
    </record>
</odoo>